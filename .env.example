# ============================================================================
# 环境变量配置模板 (Phase 3)
# 复制为 .env 并填写实际值:  cp .env.example .env
# ============================================================================

# DeepSeek API 配置 (必填)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# LLM 多 provider 故障转移（可选）
# 主 provider 重试耗尽后自动切换备用；base_url 以 | 分隔。
# 备用 key / model 按下标对应，缺省复用主配置。
# 流式输出（agents/llm_pipeline.chat_stream）自动继承该故障转移。
LLM_BACKUP_BASE_URLS=
LLM_BACKUP_API_KEYS=
LLM_BACKUP_MODELS=

# HITL 阈值
HITL_BATCH_SAVE_THRESHOLD=1000
HITL_TOKEN_COST_THRESHOLD=10.0

# 爬虫配置
MAX_PAGES=500
MAX_DEPTH=5
MAX_NAV_DEPTH=4
IMAGE_DOWNLOAD=false
REQUEST_TIMEOUT=30
REQUEST_DELAY=0.5

# 输出目录
LOCAL_BACKUP_DIR=output
CSV_OUTPUT_DIR=csv_output